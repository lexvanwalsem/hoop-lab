{
  "name": "hoop-lab",
  "version": "0.2.0",
  "description": "Browser-only jump and shot analysis with body tracking. Your videos never leave your device.",
  "license": "MIT",
  "author": "lexvanwalsem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexvanwalsem/hoop-lab.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/setup.mjs",
